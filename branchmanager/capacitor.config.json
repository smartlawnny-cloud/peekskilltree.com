{
  "appId": "com.peekskilltree.branchmanager",
  "appName": "Branch Manager",
  "webDir": "www",
  "server": {
    "allowNavigation": ["*.supabase.co", "*.stripe.com", "maps.google.com"]
  },
  "ios": {
    "backgroundColor": "#1a3c12",
    "contentInset": "automatic",
    "scheme": "Branch Manager"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "backgroundColor": "#1a3c12",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": true
    },
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#1a3c12"
    }
  }
}
